{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@toverux/blanc-hopital/tsconfig/strict", "@toverux/blanc-hopital/tsconfig/bun"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "declaration": false,
    "sourceMap": true,
    // restore noEmit to true (set to false by bun config) otherwise Angular CLI cannot build.
    "noEmit": false,
    "paths": {
      "#prisma-lib/*": ["./prisma/lib/*"]
    }
  },
  // The default "**/*" skips dot-folders, so list them explicitly.
  "include": ["**/*", ".agents/hooks/**/*"],
  "angularCompilerOptions": {
    "disableTypeScriptVersionCheck": true
  }
}
